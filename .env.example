# ==============================================================================
# CONFIGURAZIONE GESTIONE SPESE PERSONALI & BOT TELEGRAM
# ==============================================================================

# Token HTTP del bot Telegram fornito da @BotFather (es. 123456789:ABCdefGhIJKlmNoPQRstUVwxyZ)
TELEGRAM_BOT_TOKEN=tuo_token_qui

# Il tuo ID utente Telegram univoco numerico (es. 123456789).
# Puoi scoprirlo avviando il bot e leggendo il messaggio di rifiuto con il tuo ID,
# oppure scrivendo a @userinfobot su Telegram.
TELEGRAM_USER_ID=tuo_id_telegram_qui

# Budget mensile predefinito in Euro (es. 1000.0)
MONTHLY_BUDGET=1000.0

# Nome del file database SQLite locale (default: spese.db)
DB_NAME=spese.db

# URL WebApp di Google Apps Script o link di condivisione di Google Foglio
# (Consente al bot Telegram di funzionare 24h su Google Cloud anche a PC spento)
GOOGLE_SHEETS_URL=
